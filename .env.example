# Copy to .env. Never commit real secrets.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# PostgreSQL (production / docker). Local tests use SQLite if this is empty.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=outrun_aftermath;Username=outrun;Password=CHANGE_ME

Jwt__Issuer=OutrunAftermath
Jwt__Audience=OutrunAftermathClients
Jwt__SigningKey=REPLACE_WITH_32_PLUS_CHAR_RANDOM_KEY
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

Redis__ConnectionString=localhost:6379

# Photon Fusion 2 — required only if the Fusion adapter is enabled. Do not invent an AppId.
PHOTON_FUSION_APP_ID=
PHOTON_FUSION_REGION=

# Unity Gaming Services — optional, not used in Phase 0–1.
UGS_PROJECT_ID=
UGS_ENVIRONMENT=development
